{
  "name": "daggerheart-companion",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=claude-code-config,target=/home/node/.claude,type=volume"
  ],
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "App preview", "onAutoForward": "openPreview" }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y poppler-utils; [ -f package.json ] && npm install || true",
  "postStartCommand": "sudo chown -R node:node /home/node/.claude"
}